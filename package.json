{
  "name": "open-claude-router",
  "version": "0.6.1",
  "description": "Routing-stateless Anthropic <-> OpenAI protocol bridge for Claude Code. All upstream info passed per-request via headers.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:stream": "tsx scripts/verify-thinking-stream.ts",
    "test:rust-parity": "tsx scripts/verify-rust-parity.ts",
    "bench:router": "tsx scripts/benchmark-router.ts",
    "test:live": "tsx scripts/verify-live-upstream.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "js-tiktoken": "^1.0.16",
    "undici": "^7.1.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.1",
    "openai": "^4.73.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
